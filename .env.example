# Copy this file to .env before starting:   cp .env.example .env
#
# .env is gitignored; this file is not. Never commit the real .env — the
# connection string is a secret, same rule as any API key.

# ---------------------------------------------------------------------------
# Your team's assignment. You get these from the assignment sheet in week 3.
# ---------------------------------------------------------------------------
# Price area: SE1, SE2, SE3 or SE4
PRICE_AREA=SE3

# Target variable: mean = tomorrow's average price
#                  peak = tomorrow's most expensive interval
TARGET=mean

# ---------------------------------------------------------------------------
# Your own Postgres, from Neon or Supabase.
# ---------------------------------------------------------------------------
# Create a project, then copy the connection string it gives you (Neon:
# "Connection string" on the project dashboard; Supabase: Project Settings ->
# Database -> Connection string -> URI). It looks like:
#   postgresql://user:password@host/dbname?sslmode=require
#
# One .env for the whole project. Your ingestion container reads it at run
# time, and it's also what you'll hand to DuckDB's ATTACH command.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Hugging Face, from week 5.
# ---------------------------------------------------------------------------
# A write token from https://huggingface.co/settings/tokens — needed to push
# model versions to the Hub from your training pipeline. Leave blank until
# week 5. In GitHub Actions this belongs in repository secrets, not here.
HF_TOKEN=
HF_MODEL_REPO=your-org/elpris-SE3-mean

# ---------------------------------------------------------------------------
# SMHI and elprisetjustnu.se need no API key — nothing else to fill in.
# ---------------------------------------------------------------------------
